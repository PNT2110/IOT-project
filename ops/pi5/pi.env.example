# Copy to ops/pi5/pi.env and fill in. Never commit pi.env.
# __HOME__ is replaced with the Pi user's home folder during setup.
APP_ENV=production
# The Pi serves plain HTTP on its own access point.
PI_COOKIE_SECURE=false

PI_AUTH_DB_PATH=__HOME__/iot/data/pi-users.sqlite3
PI_FLIGHT_DB_PATH=__HOME__/iot/data/flights.sqlite3
PI_TILE_CACHE_DIR=__HOME__/iot/data/tiles
PI_FW_WORKDIR=__HOME__/iot/data/firmware
# At least 32 random characters; changing it makes stored 2FA keys unreadable.
PI_DATA_KEY=

# Email OTP. For Gmail: an App Password.
PI_SMTP_HOST=smtp.gmail.com
PI_SMTP_PORT=587
PI_SMTP_FROM=
PI_SMTP_USERNAME=
PI_SMTP_PASSWORD=

# Default Pi admin: created once, no email (the first login asks for one).
PI_DEFAULT_ADMIN_USERNAME=
PI_DEFAULT_ADMIN_PASSWORD=
# Base32, at least 16 characters; add it to an authenticator app.
PI_DEFAULT_ADMIN_TOTP_SECRET=

# PC server (zones + flight permission). From: python -m server.cli add-device --name <name>
PI_PC_MAP_URL=https://your-machine.your-tailnet.ts.net
PI_DEVICE_ID=
PI_DEVICE_KEY=

PI_CAMERA_DEVICE=/dev/video0
PI_UPSTREAM_IFACE=wlan0
PI_AP_IFACE=ap0
PI_AP_SSID=F450
PI_VEHICLES="F450 PNT PVD"
PI_FLIGHT_WINDOW_MIN=60
# Manufacturer firmware releases: owner/repo on GitHub.
PI_FW_GITHUB_REPO=
