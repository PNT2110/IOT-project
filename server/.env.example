# Copy to server/.env and fill in. Never commit server/.env.
APP_ENV=production
PUBLIC_MODE=true
COOKIE_SECURE=true
SEED_DEMO_DATA=false
DATABASE_URL=sqlite:///server/data/app.db
HOST=127.0.0.1
PORT=8765
FRONTEND_PORT=5173
# Public hostname without scheme (Tailscale Funnel name).
PUBLIC_HOST=your-machine.your-tailnet.ts.net
ALLOWED_ORIGINS=https://your-machine.your-tailnet.ts.net
# Long random value; changing it invalidates sessions and stored 2FA keys.
SESSION_SECRET=
TERMS_VERSION=terms-v1

# Email OTP. For Gmail: smtp.gmail.com, port 587, an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Default main account: created once at start, no email, fixed 2FA key.
DEFAULT_OWNER_USERNAME=
DEFAULT_OWNER_PASSWORD=
# Base32, at least 16 characters; add it to an authenticator app.
DEFAULT_OWNER_TOTP_SECRET=

AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_MAX_ENTRIES=10000
REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_CHALLENGE_RATE_LIMIT_MAX_ATTEMPTS=5
MAX_REQUEST_BYTES=1000000
ENABLE_TEST_ADAPTERS=false
